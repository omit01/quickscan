APP_NAME="Scouting Website Quickscan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://quickscan.example
APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
DEV_SOL_BYPASS=false

LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/quickscan/apps/web/storage/app/quickscan.sqlite
DB_QUEUE_RETRY_AFTER=1200
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# Set exact reverse-proxy IPs/CIDRs as seen by the container; never use *.
TRUSTED_PROXIES=

# Obtain actual provider settings and membership claims from the SOL administrator.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://quickscan.example/auth/sol/callback
OIDC_SCOPES="openid profile"
OIDC_MEMBERSHIP_CLAIM=
OIDC_MEMBERSHIP_VALUES=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_PAGESPEED_API_KEY=